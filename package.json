{
  "name": "solflare-interview",
  "version": "1.0.0",
  "description": "QA Automation assignment for Solflare: WebdriverIO E2E tests and Playwright API tests",
  "scripts": {
    "test": "npm run test:api && npm run test:e2e",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:e2e:chrome": "wdio run ./wdio.conf.ts --browser=chrome",
    "test:e2e:firefox": "wdio run ./wdio.conf.ts --browser=firefox",
    "test:e2e:headless": "wdio run ./wdio.conf.ts --headless",
    "test:api": "playwright test",
    "report:api": "playwright show-report reports/api",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jloncar7/solflare-interview.git"
  },
  "keywords": [
    "webdriverio",
    "playwright",
    "e2e",
    "api-testing"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jloncar7/solflare-interview/issues"
  },
  "homepage": "https://github.com/jloncar7/solflare-interview#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webdriverio": "^9.32.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
